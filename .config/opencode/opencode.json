                "qwen2.5-vl-7b-instruct": { "name": "Qwen2.5 VL 7B (Qiniu)", "attachment": true, "modalities": { "input": ["text", "image"], "output": ["text"] } },
                "kimi-k2": { "name": "Kimi K2 (Qiniu)" },
                "moonshotai/kimi-k2-0905": { "name": "Kimi K2 0905 (Qiniu)" },
                "moonshotai/kimi-k2-thinking": { "name": "Kimi K2 Thinking (Qiniu)", "thinking": true },
                "moonshotai/kimi-k2.5": { "name": "Kimi K2.5 (Qiniu)" },
                "glm-4.5": { "name": "GLM-4.5 (Qiniu)" },
                "glm-4.5-air": { "name": "GLM-4.5 Air (Qiniu)" },
