{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "plugin": [
        "opencode-antigravity-auth@latest",
        // "oh-my-opencode"
    ],
    "mcp": {
        "Git": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-server-git"
            ]
        },
        "Sequential Thinking": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ]
        },
        "Puppeteer": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ]
        },
        "Chrome DevTools MCP": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "chrome-devtools-mcp@latest"
            ]
        },
        "Memory": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "environment": {
                "MEMORY_FILE_PATH": "memory.json"
            }
        },
        "Filesystem": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "/home/shanaae/projects"
            ]
        },
        "Fetch": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-server-fetch"
            ]
        },
        "Playwright": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@executeautomation/playwright-mcp-server"
            ]
        },
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "Figma Desktop": {
            "type": "remote",
            "url": "http://127.0.0.1:3845/mcp"
        },
        "Package Version": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "mcp-package-version"
            ]
        },
        "zai-mcp-server": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@z_ai/mcp-server"
            ],
            "environment": {
                "Z_AI_MODE": "ZHIPU",
                "Z_AI_API_KEY": "{env:BIGMODEL_API_KEY}"
            }
        },
        "web-search-prime": {
            "type": "remote",
            "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
            "headers": {
                "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
            }
        },
        "web-reader": {
            "type": "remote",
            "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
            "headers": {
                "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
            }
        },
        "zread": {
            "type": "remote",
            "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
            "headers": {
                "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
            }
        }
    },
    "instructions": [
        "rules/english-learning.md",
        "rules/git-pull-context.md",
        "rules/learning.md",
        "rules/save-to-eudic.md",
        "rules/save-to-obsidian.md"
    ],
    "tools": {
        "Puppeteer": true,
        "Chrome DevTools MCP": true,
        "Playwright": true,
        "github": true
    },
    "provider": {
        "google": {
            "name": "Google",
            "models": {
                "antigravity-gemini-3-pro-high": {
                    "name": "Gemini 3 Pro High (Antigravity)",
                    "thinking": true,
                    "attachment": true,
                    "limit": {
                        "context": 1048576,
                        "output": 65535
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image",
                            "pdf"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "antigravity-gemini-3-pro-low": {
                    "name": "Gemini 3 Pro Low (Antigravity)",
                    "thinking": true,
                    "attachment": true,
                    "limit": {
                        "context": 1048576,
                        "output": 65535
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image",
                            "pdf"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                },
                "antigravity-gemini-3-flash": {
                    "name": "Gemini 3 Flash (Antigravity)",
                    "attachment": true,
                    "limit": {
                        "context": 1048576,
                        "output": 65536
                    },
                    "modalities": {
                        "input": [
                            "text",
                            "image",
                            "pdf"
                        ],
                        "output": [
                            "text"
                        ]
                    }
                }
            }
        },
        "zhipuai-coding-plan": {
            "options": {
                "apiKey": "{env:BIGMODEL_API_KEY}"
            }
        },
        "qiniu": {
            "options": {
                "baseURL": "https://api.qnaigc.com/v1",
