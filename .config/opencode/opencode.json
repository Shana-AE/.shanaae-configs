                "doubao-1.5-pro-32k": { "name": "Doubao 1.5 Pro 32K (Qiniu)" },
                "doubao-1.5-vision-pro": { "name": "Doubao 1.5 Vision Pro (Qiniu)", "attachment": true, "modalities": { "input": ["text", "image"], "output": ["text"] } },
                "doubao-seed-1.6": { "name": "Doubao Seed 1.6 (Qiniu)" },
                "doubao-seed-1.6-flash": { "name": "Doubao Seed 1.6 Flash (Qiniu)" },
                "doubao-seed-1.6-thinking": { "name": "Doubao Seed 1.6 Thinking (Qiniu)", "thinking": true },
                "xiaomi/mimo-v2-flash": { "name": "MiMo V2 Flash (Qiniu)" },
                "meituan/longcat-flash-lite": { "name": "LongCat Flash Lite (Qiniu)" }
