{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@opencode-ai/plugin": ["../../node_modules/@opencode-ai/plugin/dist/index.d.ts"],
      "@opencode-ai/plugin/tui": ["../../node_modules/@opencode-ai/plugin/dist/tui.d.ts"]
    }
  },
  "include": ["src"]
}
