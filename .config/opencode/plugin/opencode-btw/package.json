{
  "name": "opencode-btw",
  "version": "0.2.0",
  "description": "Quick side questions without polluting main context — OpenCode's /btw command (TUI plugin)",
  "type": "module",
  "main": "./src/tui.tsx",
  "exports": {
    ".": {
      "default": "./src/tui.tsx"
    },
    "./tui": {
      "default": "./src/tui.tsx"
    }
  },
  "oc-plugin": [
    "tui"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "btw",
    "side-question",
    "context",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentui/core": "0.4.3",
    "@opentui/solid": "0.4.3",
    "solid-js": "1.9.12"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.4.3"
  }
}
