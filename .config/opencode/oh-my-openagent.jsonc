{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",
  "google_auth": true,
  "agents": {
    "sisyphus": {
      "model": "qiniu/claude-4.6-sonnet",
      "fallback_models": [
        "zhipuai-coding-plan/glm-5.1",
        "qiniu/deepseek/deepseek-v3.2"
      ]
    },
    "librarian": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        "minimax-cn-coding-plan/MiniMax-M2.5-highspeed"
      ]
    },
    "explore": {
      "model": "minimax-cn-coding-plan/MiniMax-M2.5-highspeed",
      "fallback_models": [
        "zhipuai-coding-plan/glm-5.1"
      ]
    },
    "oracle": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        "qiniu/deepseek/deepseek-v3.2",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "frontend-ui-ux-engineer": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        "qiniu/claude-4.6-sonnet",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "document-writer": {
      "model": "zhipuai-coding-plan/glm-5.1",
      "fallback_models": [
        "qiniu/deepseek/deepseek-v3.2",
        "minimax-cn-coding-plan/MiniMax-M2.7"
      ]
    },
    "multimodal-looker": {
      "model": "qiniu/qwen-vl-max-2025-01-25",
      "fallback_models": [
        "qiniu/qwen3-vl-30b-a3b-thinking",
        "zhipuai-coding-plan/glm-5.1"
      ]
    }
  }
}
