{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    // "oh-my-openagent@latest",
    "@nick-vi/opencode-type-inject",
    "@franlol/opencode-md-table-formatter@latest",
    "@mohak34/opencode-notifier@latest",
    "@ramtinj95/opencode-tokenscope@latest",
    "opencode-vibeguard",
    "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    "opencode-websearch-cite"
  ],
  "mcp": {
    "Git": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ]
    },
    "Sequential-Thinking": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "Puppeteer": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    "Chrome-DevTools-MCP": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ]
    },
    "Memory": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "memory.json"
      }
    },
    "Filesystem": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/shanaae/projects"
      ]
    },
    "Fetch": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    "Playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "Figma-Desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "Package-Version": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-package-version"
      ]
    },
    "zai-mcp-server": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_MODE": "ZHIPU",
        "Z_AI_API_KEY": "{env:BIGMODEL_API_KEY}"
      }
    },
    "web-search-prime": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    },
    "web-reader": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    },
    "zread": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    }
  },
  "instructions": [
    "rules/english-learning.md",
    "rules/git-pull-context.md",
    "rules/learning.md",
    "rules/save-to-eudic.md",
    "rules/save-to-obsidian.md",
    "plugin/shell-strategy/shell_strategy.md"
  ],
  "tools": {
    "Chrome-DevTools-MCP": true,
    "github": true
  },
  "provider": {
    "zhipuai-coding-plan": {
      "options": {
        "apiKey": "{env:BIGMODEL_API_KEY}",
        "websearch_cited": {
          "model": "glm-4.6v-flash"
        }
      },
      "models": {
        "glm-4.5": {
          "name": "GLM-4.5",
          "thinking": true,
          "limit": {
            "context": 131072,
            "output": 98304
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm-4.5-air": {
          "name": "GLM-4.5 Air",
