        },
        "google/gemini-3.1-flash-lite": {
          "name": "Gemini 3.1 Flash Lite (Qiniu)",
          "reasoning": true,
          "attachment": true,
          "limit": {"context": 1000000, "output": 64000}
        },
        "doubao-seed-2.0-pro": {
          "name": "Doubao Seed 2.0 Pro (Qiniu)",
