            "context": 204800,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "glm-5-turbo": {
          "name": "GLM-5 Turbo",
          "thinking": true,
          "limit": {
            "context": 204800,
            "output": 131072
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
