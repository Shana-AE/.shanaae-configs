{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    // "oh-my-openagent",  // disabled: consumes too many tokens globally; config kept in oh-my-openagent.jsonc for when needed
    "@nick-vi/opencode-type-inject",
    "@franlol/opencode-md-table-formatter@latest",
    "@mohak34/opencode-notifier@latest",
    "@ramtinj95/opencode-tokenscope@latest",
    "opencode-vibeguard",
    // "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    // "opencode-websearch-cited"
  ],
  "mcp": {
    "Git": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ]
    },
    "Sequential-Thinking": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "Puppeteer": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ]
    },
    // Connects to Brave on Windows via the debug port. Brave must be running with:
    //   brave.exe --remote-debugging-port=9222 --user-data-dir="C:\Users\shana\brave-debug"
    // WSL is in Mirrored mode (.wslconfig: networkingMode=Mirrored + hostAddressLoopback=true),
    // so 127.0.0.1 in WSL reaches Windows directly — no 0.0.0.0 binding needed.
    "Chrome-DevTools-MCP": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ]
    },
    "Memory": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "memory.json"
      }
    },
    "Filesystem": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/shanaae/projects"
      ]
    },
    "Fetch": {
      "enabled": false,
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ]
    },
    // Connects to the SAME Brave debug instance as Chrome-DevTools-MCP (127.0.0.1:9222).
    // Uses official @playwright/mcp — the @executeautomation one lacks --cdp-endpoint.
    // Kept disabled; enable when you want Playwright's selectors/traces on the live browser.
    "Playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--cdp-endpoint",
        "http://127.0.0.1:9222"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "Figma-Desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "Package-Version": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-package-version"
      ]
    },
    "zai-mcp-server": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "environment": {
        "Z_AI_MODE": "ZHIPU",
        "Z_AI_API_KEY": "{env:BIGMODEL_API_KEY}"
      }
    },
    "web-search-prime": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    },
    "web-reader": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    },
    "zread": {
      "enabled": false,
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      }
    },
    "MiniMax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-mcp"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "MINIMAX_MCP_BASE_PATH": "/home/shanaae/minimax-output",
        "MINIMAX_API_RESOURCE_MODE": "local"
      },
      "enabled": false
    },
    "MiniMax-TokenPlan": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com"
      },
      "enabled": false
    }
  },
  "instructions": [
    "rules/english-learning.md",
    "rules/vue-learning.md",
    "rules/harmonyos-learning.md",
    "rules/git-pull-context.md",
    "rules/learning.md",
    "rules/save-to-eudic.md",
    "rules/save-to-obsidian.md",
    "plugin/shell-strategy/shell_strategy.md"
  ],
  // Chrome-DevTools-MCP tools are GLOBALLY OFF (zero token cost in main/plan context).
  // They are re-enabled only inside the `web-devtools` subagent (see agents/web-devtools.md),
  // so the MCP's ~47 tool schemas are paid for only when that subagent runs.
  "tools": {
    "Chrome-DevTools-MCP*": false,
    "github": true
  },
  "provider": {
    "qiniu": {
      "options": {
        "baseURL": "https://api.qnaigc.com/v1",
        "apiKey": "{env:QINIU_AI_API_KEY}"
      },
      "models": {
        "arcee-ai/trinity-mini": {
          "name": "Arcee-Ai/Trinity Mini (Qiniu)",
          "limit": {"context": 128000, "output": 128000}
        },
        "qwen/qwen3.7-max": {
          "name": "Qwen/Qwen3.7-Max (Qiniu)",
          "reasoning": true,
          "limit": {"context": 1000000, "output": 64000}
        },
        "qwen/qwen3.6-27b": {
          "name": "Qwen/Qwen3.6-27B (Qiniu)",
          "reasoning": true,
          "attachment": true,
          "limit": {"context": 262100, "output": 262100}
        },
        "qwen/qwen3.6-plus": {
          "name": "Qwen/Qwen3.6-Plus (Qiniu)",
