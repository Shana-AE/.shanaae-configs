{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "subagent_depth": 2,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    // "oh-my-openagent",  // disabled: consumes too many tokens globally; config kept in oh-my-openagent.jsonc for when needed
    "@nick-vi/opencode-type-inject",
    "@franlol/opencode-md-table-formatter@latest",
    "@mohak34/opencode-notifier@latest",
    "@ramtinj95/opencode-tokenscope@latest",
    "opencode-vibeguard",
    // "@tarquinen/opencode-dcp@latest",
    "opencode-pty",
    ["./plugin/project-rules", {
      "projects": {
        "vue": {
          "deps": ["vue"],
          "files": ["**/*.vue"],
          "rules": ["~/.shanaae/configs/ai/user_rules/vue-learning.md"]
        },
        "harmonyos": {
          "files": ["oh-package.json5", "build-profile.json5", "hvigorfile.ts"],
          "rules": ["~/.shanaae/configs/ai/user_rules/harmonyos-learning.md"]
        }
      }
    }],
    "./plugins/agentmemory-capture.ts",
    "@honcho-ai/opencode-honcho"
    // "opencode-websearch-cited"  // disabled: its WebsearchCitedOpenAIPlugin export overrides the built-in ChatGPT Plus/Pro OAuth login methods
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "PATH=$HOME/.local/bin:$HOME/.local/share/fnm/aliases/default/bin:$HOME/.volta/bin:/opt/homebrew/bin:$PATH; b=$HOME/.local/share/pnpm/bin/agentmemory-mcp; [ -x \"$b\" ] || b=$HOME/Library/pnpm/bin/agentmemory-mcp; export AGENTMEMORY_URL=$(cat $HOME/.shanaae/configs/.secrets.d/agentmemory_url); export AGENTMEMORY_SECRET=$(cat $HOME/.shanaae/configs/.secrets.d/agentmemory_secret); exec \"$b\" \"$@\""
      ],
      "environment": {
        "AGENTMEMORY_URL": "{env:AGENTMEMORY_URL}",
        "AGENTMEMORY_SECRET": "{env:AGENTMEMORY_SECRET}"
      }
    },
    // Connects to Brave on Windows via the debug port. Brave must be running with:
    // brave.exe --remote-debugging-port=9222 --user-data-dir="C:\Users\shana\brave-debug"
    // WSL is in Mirrored mode (.wslconfig: networkingMode=Mirrored + hostAddressLoopback=true),
    // so 127.0.0.1 in WSL reaches Windows directly — no 0.0.0.0 binding needed.
    "Chrome-DevTools-MCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ]
    },
    "Figma-Desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.shanaae/configs/.secrets.d/bigmodel_api_key}"
      }
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "PATH=$HOME/.local/bin:$HOME/.local/share/fnm/aliases/default/bin:$HOME/.volta/bin:/opt/homebrew/bin:$PATH; export Z_AI_MODE=ZHIPU; export Z_AI_API_KEY=$(cat $HOME/.shanaae/configs/.secrets.d/bigmodel_api_key); exec npx -y @z_ai/mcp-server \"$@\""
      ],
      "environment": {
        "Z_AI_MODE": "ZHIPU",
        "Z_AI_API_KEY": "{env:BIGMODEL_API_KEY}"
      }
    },
    "zread": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {file:~/.shanaae/configs/.secrets.d/bigmodel_api_key}"
      }
    },
    // Cua Driver (trycua/cua.ai) — Windows computer-use.
    // DISABLED as MCP (2026-08-05): it flooded startup with Ajv schema warnings
    // (`unknown format "uint32"/"uint64"` — Rust Schemars annotations) and paid
    // ~44 tool schemas per session. Now served as a SKILL instead:
    // ~/.config/opencode/skills/cua-driver/ (official pack + scripts/cua.sh
    // wrapper; daemon auto-starts via Scheduled Task cua-driver-serve).
    "cua-driver": {
      "type": "local",
      "command": [
        "/mnt/c/Users/shana/AppData/Local/Programs/Cua/cua-driver/bin/cua-driver.exe",
        "mcp"
      ],
      "enabled": false
    },
    // FALLBACK (uncomment if cua-driver interop proves flaky): Windows-MCP
    // (CursorTouch) over streamable-http on the Windows host, reached via the
    // Mirrored-mode loopback. Start on Windows first:
    //   uvx windows-mcp --transport streamable-http --host 127.0.0.1 --port 8765
    // "windows-mcp": {
    //   "type": "remote",
    //   "url": "http://127.0.0.1:8765/mcp",
    //   "enabled": true
    // },
    "Fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "enabled": false
    },
    "Filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:PROJECTS_DIR}"
      ],
      "enabled": false
    },
    "Git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN_MCP}"
      },
      "enabled": false
    },
    "Memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "environment": {
        "MEMORY_FILE_PATH": "memory.json"
      },
      "enabled": false
    },
    "MiniMax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-mcp"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "MINIMAX_MCP_BASE_PATH": "{env:MINIMAX_OUTPUT_DIR}",
        "MINIMAX_API_RESOURCE_MODE": "local"
      },
      "enabled": false
    },
    "MiniMax-TokenPlan": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "environment": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com"
      },
      "enabled": false
    },
    "Package-Version": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-package-version"
      ],
      "enabled": false
    },
    "Playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": false
    },
    "Puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "enabled": false
    },
    "Sequential-Thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": false
    },
    "web-reader": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      },
      "enabled": false
    }
  },
  "instructions": [
    "~/.shanaae/configs/ai/user_rules/english-learning.md",
    "~/.shanaae/configs/ai/user_rules/learning.md",
    "~/.shanaae/configs/ai/user_rules/git-pull-context.md",
    "~/.shanaae/configs/ai/user_rules/save-to-eudic.md",
    "~/.shanaae/configs/ai/user_rules/save-to-obsidian.md",
    "~/.config/opencode/plugin/shell-strategy/shell_strategy.md",
    "~/.shanaae/configs/ai/user_rules/secret-hygiene.md"
  ],
  // Chrome-DevTools-MCP tools are GLOBALLY OFF (zero token cost in main/plan context).
  // They are re-enabled only inside the `web-devtools` subagent (see agents/web-devtools.md),
  // so the MCP's ~47 tool schemas are paid for only when that subagent runs.
  // cua-driver is no longer an MCP at all (disabled above since 2026-08-05) — it is a
  // skill (~/.config/opencode/skills/cua-driver/) used by the `windows-use` subagent.
  // The pattern below is kept as a safety net if the MCP is ever re-enabled.
  "tools": {
    "Chrome-DevTools-MCP*": false,
    "cua-driver*": false
  },
  // Allow safe, read-only bash without prompting; everything else falls back to `ask`.
  // Secrets hygiene: removed `env *` (dumps exported secrets into the transcript);
  // `cat` of the secrets files now asks; `read` stays on default `ask`; `source` of the
  // secrets file stays allowed because it loads vars silently without printing values.
  "permission": {
    // lark-* skills are gated: only the 'lark' subagent may load them
    "skill": {
      "*": "allow",
      "lark-*": "deny"
    },
    "bash": {
      "git *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cat ~/.shanaae/configs/.secrets*": "ask",
      "cat /home/shanaae/.shanaae/configs/.secrets*": "ask",
      "rg *": "allow",
      "set -a": "allow",
      "set +a": "allow",
      "source ~/.shanaae/configs/.secrets*": "allow",
      "pwd": "allow",
      "bw status*": "allow",
      "bw sync*": "allow",
      "bw lock*": "allow",
      // lark-cli: ask for everything; allow only read-only non-sensitive; deny escape hatches
      "lark-cli *": "ask",
      "lark-cli --help*": "allow",
      "lark-cli help*": "allow",
      "lark-cli version*": "allow",
      "lark-cli schema *": "allow",
      "lark-cli skill *": "allow",
      "lark-cli auth status*": "allow",
      "lark-cli auth qrcode*": "allow",
      "lark-cli config show*": "allow",
      "lark-cli config strict-mode": "allow",
      "lark-cli doctor*": "allow",
      "lark-cli profile list*": "allow",
      "lark-cli calendar +agenda*": "allow",
      "lark-cli task +get-my-tasks*": "allow",
      "lark-cli attendance +get-my*": "allow",
      "lark-cli minutes +search*": "allow",
      "lark-cli api *": "deny",
      "lark-cli config remove*": "deny",
      "lark-cli config keychain-downgrade*": "deny",
      "lark-cli auth logout*": "ask"
    },
    // image-op-pro is internal-only: reachable solely via image-op's self-dispatch
    // (image-op.md declares its own task allow). Denied for primary agents so the
    // model can't pick the "pro" variant directly for general image tasks.
    "task": {
      "*": "allow",
      "image-op-pro": "deny"
    }
  },
  "provider": {
    "qiniu": {
      "options": {
        "baseURL": "https://api.qnaigc.com/v1",
        "apiKey": "{env:QINIU_AI_API_KEY}"
      },
