# =============================================================================
# 配置同步仓库 - Claude Code + OpenCode
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Claude Code - 需要同步的配置（否定规则放前面）
# -----------------------------------------------------------------------------
!.claude/.claude.json
!.claude/todos/

# Claude Code - 运行时数据（忽略规则放后面，会覆盖前面的检查）
.claude/transcripts/
.claude/shell-snapshots/
.claude/cache/
.claude/debug/
.claude/downloads/
.claude/statsig/
.claude/todos/
.claude/projects/
.claude/telemetry/
.claude/history.jsonl
.claude/backups/
.claude/.last-cleanup
.claude/daemon/
.claude/jobs/



# -----------------------------------------------------------------------------
# 2. OpenCode - 需要同步的配置（否定规则放前面）
# -----------------------------------------------------------------------------
!.config/opencode/oh-my-opencode.json
!.config/opencode/package.json
.local/share/opencode/auth.json

# OpenCode - 运行时数据（忽略规则放后面）
.local/share/opencode/storage/
.local/share/opencode/session/
.local/share/opencode/todo/
.local/share/opencode/message/
.local/share/opencode/part/
.local/share/opencode/project/
.local/share/opencode/session_diff/
.local/share/opencode/agent-usage-reminder/
.local/share/opencode/directory-agents/
.local/share/opencode/directory-readme/
.local/share/opencode/migration/

# -----------------------------------------------------------------------------
# 3. 临时和缓存文件
# -----------------------------------------------------------------------------
.local/share/opencode/log/
.local/share/opencode/bin/
.local/share/opencode/tool-output/
.local/share/opencode/*/node_modules/
.local/state/claude/locks/
.cache/claude/

# 配置文件中的临时文件
.config/opencode/node_modules/
.config/opencode/bun.lock
.config/opencode/.gitignore
.config/opencode/opencode.json

.claude/.gitignore

# ----------------------------------------------------------------------------
# 4. Trae相关
# ----------------------------------------------------------------------------

.trae/mcps/

# ----------------------------------------------------------------------------
# 4b. Codex CLI runtime (only config.toml, AGENTS.md, skills/ are tracked)
# ----------------------------------------------------------------------------
.codex/agents/
.codex/ambient-suggestions/
.codex/cache/
.codex/codex-lsp/
.codex/computer-use/
.codex/log/
.codex/logs/
.codex/mcp-oauth-locks/
.codex/plugins/
.codex/process_manager/
.codex/shell_snapshots/
.codex/sqlite/
.codex/tmp/
.codex/vendor_imports/
.codex/auth.json
.codex/cc-switch-model-catalog.json
.codex/hooks.json
.codex/installation_id
.codex/models_cache.json
.codex/*.sqlite
.codex/*.sqlite-shm
.codex/*.sqlite-wal

# ----------------------------------------------------------------------------
# 5. Claude Code Router
# ----------------------------------------------------------------------------
# .claude-code-router/  # Not ignored - config uses env vars

# -----------------------------------------------------------------------------
# 6. 通用忽略规则
# -----------------------------------------------------------------------------
.node_modules
*.log
*.tgz
coverage
dist
lib-cov
temp
.DS_Store
.idea
.vscode
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
build/
eggs/
lib/
lib64/
!.config/opencode/plugin/opencode-btw/src/lib/
parts/
sdist/
var/
wheels/
*.manifest
*.spec
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.local
.env.*.local
.AppleDouble
.LSOverride
*~
.lock
.sw?
.swp
.tmp
.trae-server/data/User/globalStorage/.mcp_gallery_cache/
.claude-code-router/.claude-code-router.pid

# All plugin data is machine-local (marketplaces, cache, config, private plugins)
# private/ holds plugins that must NOT be committed (proprietary, licensed, or
# machine-local). Each machine keeps its own copy — not synced via git.
# To set up a new machine, copy plugin dirs here and run install_all_machines.py.
.claude/plugins/*
!.claude/plugins/private/
.claude/plugins/private/*
!.claude/plugins/private/.gitkeep
!.claude/plugins/private/README.md
.claude/settings.json
.claude-code-router/config.json.*.bak
.config/opencode/opencode-notifier-state.json
.claude.*.backup*



# Sensitive config files - 含有 token 或敏感数据，不提交
.secrets
.secrets.d/
.config/opencode/antigravity-accounts.json
ai/mcp/trae.json
.local/share/opencode/auth.json
.claude/.credentials.json

# -----------------------------------------------------------------------------
# Private / machine-local skills — never committed to the remote repo.
# private/ holds skills you want linked into for-tools/ (so all AI tools pick
# them up) but NOT shared. for-tools/ is fully generated by link-skills.sh, so
# it is not tracked either — run `bash ai/skills/link-skills.sh` after every clone.
# -----------------------------------------------------------------------------
ai/skills/private/
ai/skills/for-tools/

oh-my-openagent*.bak*
*.bak
*.bak-*
*.bak.*

.trae/memory
.trae/builtin
.trae/builtin_skills

# -----------------------------------------------------------------------------
# Machine-local runtime + secret loaders (mac-mini et al.) — never committed
# -----------------------------------------------------------------------------
/secrets/
/scripts/
.config/opencode/tui.toml
.config/opencode/oh-my-openagent.jsonc.backup-*
.codex/.codex-global-state.json
.codex/.personality_migration
*.backup-*
.bw-session
.secrets.syncstate
.secrets.conflicts
.vault-sync.log
