{
    "mcpServers": {
        "Git": {
            "command": "uvx",
            "args": [
                "mcp-server-git"
            ],
            "env": {},
            "fromGalleryId": "modelcontextprotocol.servers_git"
        },
        "Sequential-Thinking": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-sequential-thinking"
            ],
            "env": {},
            "fromGalleryId": "modelcontextprotocol.servers_sequentialthinking"
        },
        "shadcn-ui": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ],
            "env": {},
            "fromGalleryId": "byted-mcp.shadcn-ui",
            "disabled": true
        },
        "Figma-Desktop": {
            "url": "http://127.0.0.1:3845/mcp",
            "type": "http",
            "disabled": false
        },
        "Chrome-DevTools-MCP": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest",
                "--browser-url=http://127.0.0.1:9222",
                "--no-usage-statistics"
            ],
            "env": {},
            "fromGalleryId": "byted-mcp.chrome-devtools-mcp"
        },
        "context7": {
          "command": "npx",
          "args": [
            "-y",
            "@upstash/context7-mcp@latest",
            "--api-key",
            "YOUR_CONTEXT7_API_KEY"
          ],
          "url": null,
          "env": null,
          "headers": null,
          "fromGalleryId": "upstash.context7"
        },
        "Memory": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-memory"
          ],
          "env": {
            "MEMORY_FILE_PATH": "memory.json"
          },
          "url": null,
          "headers": null,
          "fromGalleryId": "modelcontextprotocol.servers_memory"
        },
        "Filesystem": {
          "command": "npx",
          "args": [
            "-y",
            "@modelcontextprotocol/server-filesystem",
            "/home/shanaae/projects"
          ],
          "env": {},
          "fromGalleryId": "modelcontextprotocol.servers_filesystem"
        },
        "Fetch": {
          "command": "uvx",
          "args": [
            "mcp-server-fetch"
          ],
          "env": {},
          "url": null,
          "headers": null,
          "fromGalleryId": "modelcontextprotocol.servers_fetch"
        },
        "Playwright": {
          "command": "npx",
          "args": [
            "-y",
            "@playwright/mcp@latest",
            "--cdp-endpoint",
            "http://127.0.0.1:9222"
          ],
          "env": {},
          "url": null,
          "headers": null
        },
        "github": {
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": {
            "Authorization": "Bearer YOUR_GITHUB_TOKEN"
          },
          "command": null,
          "args": null,
          "env": null
        }
    }
}
