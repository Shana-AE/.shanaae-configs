{
  "_doc": "Claude provider definitions for cc-switch. Used by setup_claude_providers.py to configure cc-switch's DB and/or write settings.json. No secrets — API key is read from .secrets at runtime.",
  "base_url": "https://api.qnaigc.com",
  "api_key_env": "QINIU_AI_API_KEY",
  "common_config": {
    "env": {
      "companyAnnouncements": [
        "using ccr 🚀"
      ]
    },
    "permissions": {
      "allow": [
        "mcp__codegraph__*"
      ]
    },
    "hooks": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "codegraph prompt-hook"
            }
          ]
        }
      ]
    },
    "enabledPlugins": {
      "agentmemory@agentmemory": true,
      "honcho@honcho": true
    },
    "extraKnownMarketplaces": {
      "agentmemory": {
        "source": {
          "source": "github",
          "repo": "rohitg00/agentmemory"
        }
      },
      "honcho": {
        "source": {
          "source": "github",
          "repo": "plastic-labs/claude-honcho"
        }
      }
    }
  },
  "default_provider": "qiniu-claude",
  "providers": [
    {
      "id": "qiniu-claude",
      "name": "Qiniu · Claude",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "claude-4.6-sonnet",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-4.5-haiku",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "claude-4.5-haiku",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-4.6-sonnet",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "claude-4.6-sonnet",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "anthropic/claude-4.8-opus",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "anthropic/claude-4.8-opus",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "anthropic/claude-fable-5",
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "anthropic/claude-fable-5"
      }
    },
    {
      "id": "qiniu-deepseek-v4",
      "name": "Qiniu · DeepSeek V4",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "deepseek/deepseek-v4-flash",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "deepseek/deepseek-v4-flash",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "deepseek/deepseek-v4-pro-202606",
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "deepseek/deepseek-v4-pro-202606"
      }
    },
    {
      "id": "qiniu-glm-52",
      "name": "Qiniu · GLM-5.2",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "z-ai/glm-5.2"
      }
    },
    {
      "id": "qiniu-gpt-55",
      "name": "Qiniu · GPT-5.5",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "openai/gpt-5.5"
      }
    },
    {
      "id": "qiniu-gpt-56-sol",
      "name": "Qiniu · GPT-5.6",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "openai/gpt-5.5",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "openai/gpt-5.6-luna",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME": "openai/gpt-5.6-luna",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "openai/gpt-5.6-terra",
        "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME": "openai/gpt-5.6-terra",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "openai/gpt-5.6-sol",
        "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME": "openai/gpt-5.6-sol",
        "ANTHROPIC_DEFAULT_FABLE_MODEL": "openai/gpt-5.6-sol",
        "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME": "openai/gpt-5.6-sol"
      }
    },
    {
      "id": "qiniu-grok-45",
      "name": "Qiniu · Grok 4.5",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "x-ai/grok-4.5"
      }
    },
    {
      "id": "qiniu-kimi-k27",
      "name": "Qiniu · Kimi K2.7 Code",
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.qnaigc.com",
        "ANTHROPIC_MODEL": "moonshotai/kimi-k2.7-code"
      }
    }
  ]
}
