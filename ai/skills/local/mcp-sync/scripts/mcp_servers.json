{
  "_doc": "Canonical MCP server definitions. Source of truth rendered into opencode.jsonc, ~/.claude.json, .claude/mcp.json, and ~/.codex/config.toml by sync_mcp.py. Edit this file, then run: python3 sync_mcp.py --dry-run",
  "_secret_syntax": "Use {env:VAR_NAME} for any secret/OS-specific value. Renderer: opencode keeps {env:VAR}; ~/.claude.json resolves to plaintext; .claude/mcp.json converts to ${VAR_NAME}; ~/.codex/config.toml maps to env_name refs (env_vars/bearer_token_env_var/env_http_headers).",
  "_enabled_semantics": "enabled=true -> active. enabled=false -> opencode emits 'enabled:false', claude/mcp.json emit 'disabled:true', codex emits 'enabled = false'. Servers in exclude_from_opencode are omitted from opencode.jsonc (managed by omo at runtime) but still written to claude and codex configs.",
  "exclude_from_opencode": [
    "context7",
    "codegraph"
  ],
  "servers": {
    "Chrome-DevTools-MCP": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:9222",
        "--no-usage-statistics"
      ],
      "env": {},
      "enabled": true,
      "comment": "Connects to Brave on Windows via the debug port. Brave must be running with:\nbrave.exe --remote-debugging-port=9222 --user-data-dir=\"C:\\Users\\shana\\brave-debug\"\nWSL is in Mirrored mode (.wslconfig: networkingMode=Mirrored + hostAddressLoopback=true),\nso 127.0.0.1 in WSL reaches Windows directly — no 0.0.0.0 binding needed."
    },
    "web-search-prime": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      },
      "headers_opencode": {
        "Authorization": "Bearer {file:~/.shanaae/configs/.secrets.d/bigmodel_api_key}"
      },
      "enabled": true
    },
    "zread": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      },
      "headers_opencode": {
        "Authorization": "Bearer {file:~/.shanaae/configs/.secrets.d/bigmodel_api_key}"
      },
      "enabled": true
    },
    "Figma-Desktop": {
      "type": "remote",
      "url": "http://127.0.0.1:3845/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "env": {},
      "enabled": true
    },
    "zai-mcp-server": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@z_ai/mcp-server"
      ],
      "command_opencode": [
        "sh",
        "-c",
        "export Z_AI_MODE=ZHIPU; export Z_AI_API_KEY=$(cat $HOME/.shanaae/configs/.secrets.d/bigmodel_api_key); exec npx -y @z_ai/mcp-server \"$@\""
      ],
      "env": {
        "Z_AI_MODE": "ZHIPU",
        "Z_AI_API_KEY": "{env:BIGMODEL_API_KEY}"
      },
      "enabled": true
    },
    "Git": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-git"
      ],
      "env": {},
      "enabled": false
    },
    "Memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "memory.json"
      },
      "enabled": false
    },
    "Filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "{env:PROJECTS_DIR}"
      ],
      "env": {},
      "enabled": false
    },
    "Sequential-Thinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {},
      "enabled": false
    },
    "MiniMax": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-mcp"
      ],
      "env": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com",
        "MINIMAX_MCP_BASE_PATH": "{env:MINIMAX_OUTPUT_DIR}",
        "MINIMAX_API_RESOURCE_MODE": "local"
      },
      "enabled": false
    },
    "MiniMax-TokenPlan": {
      "type": "local",
      "command": [
        "uvx",
        "minimax-coding-plan-mcp",
        "-y"
      ],
      "env": {
        "MINIMAX_API_KEY": "{env:MINIMAX_TOKEN_PLAN_API_KEY}",
        "MINIMAX_API_HOST": "https://api.minimaxi.com"
      },
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "Puppeteer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "env": {},
      "enabled": false
    },
    "Playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "env": {},
      "enabled": false
    },
    "Package-Version": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-package-version"
      ],
      "env": {},
      "enabled": false
    },
    "Fetch": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-server-fetch"
      ],
      "env": {},
      "enabled": false
    },
    "web-reader": {
      "type": "remote",
      "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:BIGMODEL_API_KEY}"
      },
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN_MCP}"
      },
      "enabled": false
    },
    "agentmemory": {
      "type": "local",
      "command": [
        "agentmemory-mcp"
      ],
      "command_opencode": [
        "sh",
        "-c",
        "b=$HOME/.local/share/pnpm/bin/agentmemory-mcp; [ -x \"$b\" ] || b=$HOME/Library/pnpm/bin/agentmemory-mcp; export AGENTMEMORY_URL=$(cat $HOME/.shanaae/configs/.secrets.d/agentmemory_url); export AGENTMEMORY_SECRET=$(cat $HOME/.shanaae/configs/.secrets.d/agentmemory_secret); exec \"$b\" \"$@\""
      ],
      "env": {
        "AGENTMEMORY_URL": "{env:AGENTMEMORY_URL}",
        "AGENTMEMORY_SECRET": "{env:AGENTMEMORY_SECRET}"
      },
      "enabled": true
    }
  }
}