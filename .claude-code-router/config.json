{
  "APIKEY": "$CCR_API_KEY",
  "PROXY_URL": "$CCR_PROXY_URL",
  "LOG": true,
  "LOG_LEVEL": "info",
  "API_TIMEOUT_MS": 600000,
  "NON_INTERACTIVE_MODE": false,
  "Providers": [
    {
      "name": "qiniu",
      "api_base_url": "https://api.qnaigc.com/v1/chat/completions",
      "api_key": "$QINIU_AI_API_KEY",
      "models": [
        "claude-4.6-sonnet",
        "claude-4.5-sonnet",
        "claude-4.5-haiku",
        "deepseek-r1",
        "deepseek-r1-0528",
        "deepseek-v3",
        "deepseek-v3-0324",
        "deepseek-v3.1",
        "deepseek/deepseek-v3.1-terminus",
        "deepseek/deepseek-v3.1-terminus-thinking",
        "deepseek/deepseek-v3.2-251201",
        "deepseek/deepseek-v3.2-exp",
        "deepseek/deepseek-v3.2-exp-thinking",
        "qwen-turbo",
        "qwen-max-2025-01-25",
        "qwen-vl-max-2025-01-25",
        "qwen3-32b",
        "qwen3-30b-a3b",
        "qwen3-30b-a3b-instruct-2507",
        "qwen3-30b-a3b-thinking-2507",
        "qwen3-235b-a22b",
        "qwen3-235b-a22b-instruct-2507",
        "qwen3-235b-a22b-thinking-2507",
        "qwen3-coder-480b-a35b-instruct",
        "qwen3-max",
        "qwen3-max-preview",
        "qwen3-next-80b-a3b-instruct",
        "qwen3-next-80b-a3b-thinking",
        "qwen3-vl-30b-a3b-thinking",
        "qwen2.5-vl-72b-instruct",
        "qwen2.5-vl-7b-instruct",
        "kimi-k2",
        "moonshotai/kimi-k2-0905",
        "moonshotai/kimi-k2-thinking",
        "moonshotai/kimi-k2.5",
        "glm-4.5",
        "glm-4.5-air",
        "z-ai/glm-4.6",
        "z-ai/glm-4.7",
        "z-ai/glm-5",
        "MiniMax-M1",
        "minimax/minimax-m2",
        "minimax/minimax-m2.1",
        "minimax/minimax-m2.5",
        "doubao-1.5-thinking-pro",
        "doubao-1.5-pro-32k",
        "doubao-1.5-vision-pro",
        "doubao-seed-1.6",
        "doubao-seed-1.6-flash",
        "doubao-seed-1.6-thinking",
        "xiaomi/mimo-v2-flash",
        "meituan/longcat-flash-lite"
      ],
      "transformer": {
        "use": ["Anthropic"]
      }
    },
    {
      "name": "zhipuai-coding-plan",
      "api_base_url": "https://open.bigmodel.cn/api/paas/v4/chat/completions",
      "api_key": "$BIGMODEL_API_KEY",
      "models": [
        "glm-4.5",
        "glm-4.5-air",
        "glm-4-plus",
        "glm-4-flash",
        "glm-4-flash-250414",
        "glm-4-long",
        "glm-z1-air",
        "glm-z1-airx",
        "glm-z1-flash"
      ],
      "transformer": {
        "use": ["Anthropic"],
        "glm-z1-air": {
          "use": ["reasoning"]
        },
        "glm-z1-airx": {
          "use": ["reasoning"]
        },
        "glm-z1-flash": {
          "use": ["reasoning"]
        }
      }
    },
    {
      "name": "deepseek",
      "api_base_url": "https://api.deepseek.com/chat/completions",
      "api_key": "$DEEPSEEK_API_KEY",
      "models": [
        "deepseek-chat",
        "deepseek-reasoner"
      ],
      "transformer": {
        "use": ["deepseek"],
        "deepseek-chat": {
          "use": ["tooluse"]
        }
      }
    },
    {
      "name": "openrouter",
      "api_base_url": "https://openrouter.ai/api/v1/chat/completions",
      "api_key": "$OPENROUTER_API_KEY",
      "models": [
        "anthropic/claude-sonnet-4",
        "anthropic/claude-3.5-sonnet",
        "anthropic/claude-3.7-sonnet:thinking",
        "google/gemini-2.5-pro-preview",
        "google/gemini-2.5-flash",
        "deepseek/deepseek-chat",
        "deepseek/deepseek-r1"
      ],
      "transformer": {
        "use": ["openrouter"],
        "anthropic/claude-3.7-sonnet:thinking": {
          "use": ["reasoning"]
        },
        "deepseek/deepseek-r1": {
          "use": ["reasoning"]
        }
      }
    },
    {
      "name": "siliconflow",
      "api_base_url": "https://api.siliconflow.cn/v1/chat/completions",
      "api_key": "$SILICONFLOW_API_KEY",
      "models": [
        "moonshotai/Kimi-K2-Instruct",
        "deepseek-ai/DeepSeek-V3",
        "Qwen/Qwen3-235B-A22B-Thinking-2507"
      ],
      "transformer": {
        "use": [
          ["maxtoken", { "max_tokens": 16384 }]
        ],
        "Qwen/Qwen3-235B-A22B-Thinking-2507": {
          "use": ["reasoning"]
        }
      }
    }
  ],
  "Router": {
    "default": "qiniu,deepseek-v3.1",
    "background": "qiniu,deepseek-v3",
    "think": "qiniu,deepseek-r1",
    "longContext": "qiniu,qwen3-max",
    "longContextThreshold": 60000,
    "webSearch": "qiniu,qwen3-max",
    "image": "qiniu,qwen-vl-max-2025-01-25"
  }
}
