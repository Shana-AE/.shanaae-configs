{
  "env": {
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:3456",
    "companyAnnouncements": [
      "using ccr 🚀"
    ]
  },
  "permissions": {
    "allow": [
      "mcp__codegraph__*"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "agentmemory": {
      "source": {
        "source": "github",
        "repo": "rohitg00/agentmemory"
      }
    }
  },
  "enabledPlugins": {
    "agentmemory@agentmemory": true
  }
}
