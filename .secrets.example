# =============================================================================
# .secrets.example — copy to .secrets and fill in.  NEVER commit .secrets.
# =============================================================================
# Layered by the repo's cross-platform design (spec §5): configs stay portable
# and reference these variables by name; each machine supplies its own values.
#
#   Linux / macOS : cp .secrets.example .secrets && $EDITOR .secrets
#   Windows       : copy .secrets.example .secrets  (then edit)
#   Then          : python3 install.py --all
# =============================================================================

# --- Canonical paths (per-OS samples) ---------------------------------------
# AI_CONFIGS_ROOT is auto-derived by install.py into env.sh / env.ps1.
# PROJECTS_DIR
#   Linux/macOS : /home/shanaae/projects
#   Windows     : C:\Users\shana\projects
PROJECTS_DIR=
# MINIMAX_OUTPUT_DIR
#   Linux/macOS : /home/shanaae/minimax-output
#   Windows     : C:\Users\shana\minimax-output
MINIMAX_OUTPUT_DIR=
# BRAVE_DEBUG_URL (same on all OSes; WSL mirrored networking reaches Windows)
BRAVE_DEBUG_URL=http://127.0.0.1:9222
# OBSIDIAN_VAULT_DIR
#   Linux/WSL   : /mnt/e/Users/shana/Documents/Obsidian Vault/obsidian-vault
#   macOS       : ~/Developer/obsidian-vault
#   Windows     : E:\Users\shana\Documents\Obsidian Vault\obsidian-vault
OBSIDIAN_VAULT_DIR=
# DSH_HOME (optional; dsh defaults to ~/.dsh)
# DSH_HOME=
# DEVECO_CLI_CLT_PATH (HarmonyOS DevEco toolchain stub; OS-specific)
DEVECO_CLI_CLT_PATH=

